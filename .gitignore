# Build directories
build/
build-*/
build[0-9]*/
out/
cmake-build-*/
*.obj
*.o
*.a
*.lib
*.exp
*.pdb
*.ilk

# Produced binaries / installers (artifacts are uploaded by CI, never committed)
dist/
installer-output/
*.exe
*.dll
*.pkg
*.dmg
*.AppImage
*.app/
*.workflow/
*.nsi.exe

# WebView2 loader binaries are vendored build inputs (needed by CMake POST_BUILD
# and NSIS packaging), not generated artifacts — keep them tracked.
!vendor/webview2/**/*.dll
!vendor/webview2/**/*.lib

# Python helpers
__pycache__/
*.pyc

# macOS
.DS_Store

# Editor / IDE
.vscode/
.idea/
*.swp

# Local test data
big-*.log
*.log
!docs/*.log
.cache/
