StartupWMClass=RapidEditor
MimeType=text/plain;text/x-csrc;text/x-chdr;text/x-c++src;text/x-c++hdr;text/x-python;application/json;application/xml;application/x-shellscript;application/x-yaml;text/markdown;text/x-log;text/csv;text/x-sql;text/x-ini;
