#!/bin/sh
# AppRun for the RapidEditor AppImage. Uses only /bin/sh so the AppImage works
# on minimal systems; bundled libraries are preferred over system ones.
HERE="$(dirname "$(readlink -f "$0")")"
export LD_LIBRARY_PATH="$HERE/usr/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
export XDG_DATA_DIRS="$HERE/usr/share${XDG_DATA_DIRS:+:$XDG_DATA_DIRS}"
exec "$HERE/usr/bin/RapidEditor" "$@"
