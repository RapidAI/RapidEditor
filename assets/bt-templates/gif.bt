// GIF87a / GIF89a: header, logical screen, color table, image and extension blocks
LittleEndian();
if (FSize() >= 13) {
    uint32 sig;                     // "GIF8"
    if (sig == 0x38464947) {
        FSeek(0);
        char magic[6];
        ushort width;
        ushort height;
        ubyte packed;
        ubyte bg;
        ubyte aspect;
        if ((packed & 0x80) != 0) {
            uint32 colors = 1 << ((packed & 7) + 1);
            if (FTell() + colors * 3 <= FSize()) {
                ubyte palette[colors * 3];
            }
        }
        uint32 blocks = 0;
        while (!FEof() && blocks < 64) {
            if (FTell() >= FSize()) break;
            if (FTell() + 1 > FSize()) break;
            ubyte lead;
            if (lead == 0x3B) break;                // trailer
            if (lead == 0x21) {                      // extension block
                if (FTell() + 1 > FSize()) break;
                ubyte label;
                uint32 sub = 0;
                while (!FEof() && sub < 64) {
                    if (FTell() >= FSize()) break;
                    if (FTell() + 1 > FSize()) break;
                    ubyte size;
                    if (size == 0) break;
                    if (FTell() + size > FSize()) break;
                    ubyte data[size];
                    sub = sub + 1;
                }
            } else if (lead == 0x2C) {               // image descriptor
                if (FTell() + 9 > FSize()) break;
                ushort left;
                ushort top;
                ushort iw;
                ushort ih;
                ubyte ipacked;
                if ((ipacked & 0x80) != 0) {
                    uint32 n = 1 << ((ipacked & 7) + 1);
                    if (FTell() + n * 3 <= FSize()) {
                        ubyte local_palette[n * 3];
                    }
                }
                if (FTell() + 1 > FSize()) break;
                ubyte lzw_min;
                uint32 sub = 0;
                while (!FEof() && sub < 64) {
                    if (FTell() >= FSize()) break;
                    if (FTell() + 1 > FSize()) break;
                    ubyte sz;
                    if (sz == 0) break;
                    if (FTell() + sz > FSize()) break;
                    ubyte img[sz];
                    sub = sub + 1;
                }
            } else {
                break;
            }
            blocks = blocks + 1;
        }
    }
}
