// ELF32 header (little endian): identification, program and section headers
LittleEndian();
if (FSize() >= 52) {
    uint32 magic;                   // 0x7F 'E' 'L' 'F'
    if (magic == 0x464C457F) {
        FSeek(0);
        struct Elf32_Ehdr {
            ubyte ident[16];
            ushort e_type;
            ushort e_machine;
            uint32 e_version;
            uint32 e_entry;
            uint32 e_phoff;
            uint32 e_shoff;
            uint32 e_flags;
            ushort e_ehsize;
            ushort e_phentsize;
            ushort e_phnum;
            ushort e_shentsize;
            ushort e_shnum;
            ushort e_shstrndx;
        };
        Elf32_Ehdr elf;
        if (elf.e_phoff > 0 && elf.e_phoff + 32 <= FSize()) {
            FSeek(elf.e_phoff);
            struct Elf32_Phdr {
                uint32 p_type;
                uint32 p_offset;
                uint32 p_vaddr;
                uint32 p_paddr;
                uint32 p_filesz;
                uint32 p_memsz;
                uint32 p_flags;
                uint32 p_align;
            };
            uint32 p = 0;
            while (p < 16 && FTell() + 32 <= FSize()) {
                if (FTell() >= FSize()) break;
                Elf32_Phdr phdr;
                p = p + 1;
            }
        }
    }
}
