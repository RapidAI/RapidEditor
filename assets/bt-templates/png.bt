// PNG image format: signature followed by a sequence of chunks
BigEndian();
struct Chunk {
    uint32 length;
    char   type[4];
    ubyte  data[length];
    uint32 crc;
};
ubyte signature[8];
uint32 chunks = 0;
while (!FEof() && chunks < 64) {
    if (FTell() >= FSize()) break;
    if (FTell() + 8 > FSize()) break;
    Chunk chunk;
    chunks = chunks + 1;
}
