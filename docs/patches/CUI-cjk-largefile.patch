+    float acc = 0;
+    int i = a;
+    while (i < e) {
+        if (s[i] == '\t') {
+            float stop = (float)tab * cw;
+            float next = (floorf(acc / stop) + 1.0f) * stop;
+            if (px < (acc + next) * 0.5f) break;
+            acc = next;
+            i++;
