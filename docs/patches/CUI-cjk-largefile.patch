+static float cui__ed_span(cui_ctx *ui, float size, float cw, int tab,
+                          const char *s, int a, int b) {
+    float x = 0;
+    int i = a;
+    while (i < b) {
+        int j = i;
+        while (j < b && s[j] != '\t') {
+            uint32_t cp;
+            int n = cui__utf8_decode(s + j, b - j, &cp);
+            j += n > 0 ? n : 1;
+        }
