+/* OS-delivered "open this file" requests (macOS Apple Events). A small global
+ * queue is used instead of the per-frame drop buffer because the events can
+ * arrive before cui_app_create() has made a window. All of this runs on the
+ * main thread, so no locking is needed. */
+#define CUI__PENDING_FILES_MAX 64
+static char *cui__pending_files[CUI__PENDING_FILES_MAX];
+static int cui__pending_files_count;
+
+void cui_app_post_open_file(const char *utf8_path) {
+    if (!utf8_path || !*utf8_path || cui__pending_files_count >= CUI__PENDING_FILES_MAX) return;
+    size_t n = strlen(utf8_path) + 1;
+    char *copy = (char *)malloc(n);
+    if (!copy) return;
+    memcpy(copy, utf8_path, n);
+    cui__pending_files[cui__pending_files_count++] = copy;
+}
+
+int cui_app_pending_file_count(void) { return cui__pending_files_count; }
+
+const char *cui_app_pending_file(int index) {
+    return (index >= 0 && index < cui__pending_files_count) ? cui__pending_files[index] : NULL;
+}
+
+void cui_app_clear_pending_files(void) {
+    for (int i = 0; i < cui__pending_files_count; i++) free(cui__pending_files[i]);
+    cui__pending_files_count = 0;
+}
