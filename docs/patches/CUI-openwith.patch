+/* Finder "Open With", Finder Quick Actions and drops on the Dock icon arrive
+ * as Apple Events, not as argv. Queue them so the app opens them on its next
+ * frame (see cui_app_pending_file_count() in cui_app.c). This is what makes a
+ * right-click "Open with RapidEditor" work on macOS, including when the app
+ * is already running. */
+- (BOOL)application:(NSApplication *)sender openFile:(NSString *)filename {
+    (void)sender;
+    cui_app_post_open_file(filename.fileSystemRepresentation);
+    cui__mac_wake();
+    return YES;
+}
+- (void)application:(NSApplication *)sender openFiles:(NSArray<NSString *> *)filenames {
+    (void)sender;
+    for (NSString *f in filenames) cui_app_post_open_file(f.fileSystemRepresentation);
+    cui__mac_wake();
+    [NSApp replyToOpenOrPrint:NSApplicationDelegateReplySuccess];
+}
